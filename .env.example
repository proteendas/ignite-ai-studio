# =============================================================================
# IgniteAI Studio — environment configuration
#
# Copy this file to .env.local (for local/manual dev) — Docker Compose reads
# from a plain `.env` file in the project root instead (see docker-compose.yml
# `env_file:`), so for Docker usage copy this to `.env` instead.
#
# Never commit .env / .env.local — both are gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# AI provider selection
# -----------------------------------------------------------------------------
# Set which provider to prefer. If unset, or if the requested provider has no
# key configured below, the app falls back to the first provider (in a fixed
# priority order) that DOES have a key present.
AI_PROVIDER=groq

# ---- Embeddings provider (independent of the chat provider) ----
# Default: gemini (Google Gemini Embedding API — generous free tier, strong
# multilingual quality, large context). Fallback: huggingface
# (sentence-transformers, free tier). Pick one; keys can also be set per-user
# in Settings (encrypted at rest).
# EMBEDDINGS_PROVIDER=gemini
# GOOGLE_GEMINI_API_KEY=

# EMBEDDINGS_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Model selection ----
# Models are DISCOVERED from your API key — the app asks each provider which
# models the key can use and picks the best chat model and a cheap one for
# internal calls. You do not need to set anything here, and a provider retiring
# a model id no longer breaks the app.
#
# To pin a specific model, set <PROVIDER>_CHAT_MODEL. An explicit value always
# wins over discovery:
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# OPENAI_CHAT_MODEL=gpt-4o-mini
# MISTRAL_CHAT_MODEL=mistral-small-latest
# CEREBRAS_CHAT_MODEL=
# OPENROUTER_CHAT_MODEL=
# TOGETHER_CHAT_MODEL=
# GITHUB_MODELS_CHAT_MODEL=
# HUGGINGFACE_CHAT_MODEL=

# ---- Uncomment ONE or more providers below and add your key ----

# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# GOOGLE_GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=
# GITHUB_MODELS_TOKEN=
# CLOUDFLARE_WORKERS_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# TOGETHER_API_KEY=

# ---- Local AI (no API key required) ----
# Connection type: cloud (default) | local (Ollama only, offline) | auto (prefer local, fall back to cloud)
# CONNECTION_TYPE=auto
# OLLAMA_BASE_URL=http://localhost:11434
# In Docker, the container cannot see the host's localhost — use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDINGS_PROVIDER=ollama   # embed locally too (fully offline RAG)
# Note: CONNECTION_TYPE=local defaults embeddings to Ollama automatically;
# CONNECTION_TYPE=auto keeps the cloud embeddings default (gemini) unless
# EMBEDDINGS_PROVIDER=ollama is set explicitly.

# -----------------------------------------------------------------------------
# Database (Postgres) — REQUIRED
# -----------------------------------------------------------------------------
# Any Postgres works: the compose-managed container, Neon, Supabase, RDS.
#
# Local (docker compose up -d postgres):
DATABASE_URL=postgres://igniteai:igniteai@localhost:5432/igniteai?sslmode=disable
#
# Serverless (Vercel + Neon): use the POOLED connection string — its host
# contains "-pooler". Each serverless instance opens its own pool, and a direct
# endpoint runs out of connections quickly.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Max connections per instance. Keep small on serverless; the platform runs
# many instances and Postgres limits connections per server, not per instance.
# PG_POOL_MAX=5

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# pgvector (default) keeps embeddings in the same Postgres database — one
# datastore, one backup, and it works on serverless where Chroma cannot run.
# Alternatives: chroma | faiss | azure-ai-search (faiss/azure are stubs).
VECTOR_DB_PROVIDER=pgvector

# Embedding width is DERIVED from the first real embedding — you do not need to
# set it. The width depends on which model actually answers (Gemini falls back
# from text-embedding-004 at 768 to gemini-embedding-001 at 3072), so a
# configured guess only ever blocks ingestion.
#
# If the width changes and the vector table is empty, it is recreated
# automatically. If it already holds documents, ingestion stops and tells you to
# re-ingest — vectors from different models are not comparable.
# EMBEDDING_DIMENSIONS=

# Only used with VECTOR_DB_PROVIDER=chroma. Start it with:
#   docker compose --profile chroma up -d chroma
# CHROMA_URL=http://chroma:8000

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Encryption key for per-user provider API keys stored in the DB (AES-256-GCM).
# REQUIRED for the Settings "manage API keys" feature. Min 16 chars.
# Generate: `openssl rand -base64 32`. Rotating this invalidates all stored keys.
ENCRYPTION_KEY=change-me-to-a-random-encryption-key

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Transactional email (password reset + email verification) via Resend
# -----------------------------------------------------------------------------
# Optional. With no key the mailer writes the message and its action link to
# the server console instead of sending, so the flows still work locally.
# In production set BOTH, or users never receive their reset links.
# RESEND_API_KEY=re_...
# EMAIL_FROM="IgniteAI Studio <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# true serves /maintenance for every page and 503 for every API route.
# MAINTENANCE_MODE=false
