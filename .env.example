# =============================================================================
# IgniteAI Studio — environment configuration
#
# Copy this file to .env.local (for local/manual dev) — Docker Compose reads
# from a plain `.env` file in the project root instead (see docker-compose.yml
# `env_file:`), so for Docker usage copy this to `.env` instead.
#
# Never commit .env / .env.local — both are gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# AI provider selection
# -----------------------------------------------------------------------------
# Set which provider to prefer. If unset, or if the requested provider has no
# key configured below, the app falls back to the first provider (in a fixed
# priority order) that DOES have a key present.
AI_PROVIDER=groq

# ---- Embeddings provider (independent of the chat provider) ----
# Default: gemini (Google Gemini Embedding API — generous free tier, strong
# multilingual quality, large context). Fallback: huggingface
# (sentence-transformers, free tier). Pick one; keys can also be set per-user
# in Settings (encrypted at rest).
# EMBEDDINGS_PROVIDER=gemini
# GOOGLE_GEMINI_API_KEY=

# EMBEDDINGS_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Uncomment ONE or more providers below and add your key ----

# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# GOOGLE_GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=
# GITHUB_MODELS_TOKEN=
# CLOUDFLARE_WORKERS_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# TOGETHER_API_KEY=

# ---- Local AI (no API key required) ----
# Connection type: cloud (default) | local (Ollama only, offline) | auto (prefer local, fall back to cloud)
# CONNECTION_TYPE=auto
# OLLAMA_BASE_URL=http://localhost:11434
# In Docker, the container cannot see the host's localhost — use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDINGS_PROVIDER=ollama   # embed locally too (fully offline RAG)
# Note: CONNECTION_TYPE=local defaults embeddings to Ollama automatically;
# CONNECTION_TYPE=auto keeps the cloud embeddings default (gemini) unless
# EMBEDDINGS_PROVIDER=ollama is set explicitly.

# -----------------------------------------------------------------------------
# Vector store / DB
# -----------------------------------------------------------------------------
# One of: chroma | faiss | azure-ai-search  (only "chroma" is fully wired;
# faiss/azure-ai-search are documented stubs — see lib/db/vector/*.ts)
VECTOR_DB_PROVIDER=chroma

# Where the app reaches Chroma. In Docker Compose this resolves to the
# `chroma` service by its service name; for manual/local dev run Chroma
# yourself (e.g. `docker run -p 8000:8000 chromadb/chroma`) and point here.
CHROMA_URL=http://chroma:8000

# SQLite file path. In Docker this lives on a named volume so data survives
# container restarts; for manual/local dev this can just be a relative path.
SQLITE_PATH=/app/data/app.db

# Optional: only needed if you wire up a real Postgres/Cosmos DB backend for
# structured data instead of the built-in SQLite demo tables.
# SQL_DB_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Encryption key for per-user provider API keys stored in the DB (AES-256-GCM).
# REQUIRED for the Settings "manage API keys" feature. Min 16 chars.
# Generate: `openssl rand -base64 32`. Rotating this invalidates all stored keys.
ENCRYPTION_KEY=change-me-to-a-random-encryption-key

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
